---
import { getCollection } from 'astro:content';
import '../styles/global.css'
import '@fontsource/jetbrains-mono';
import itsLogo from '../assets/Lambang-ITS.png';
import smantaruLogo from '../assets/smantaru.png';

const projects = await getCollection('projects');

---

<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | IT & Systems</title>
  </head>

  <!-- <body class="min-h-screen bg-gradient-to-br from-gray-600 to-black text-white font-mono"> -->
  <body class="min-h-screen text-white font-mono" style="background-color: black">
    <main>
      <!-- Hero Header -->
      <!-- <section class="box font-mono" style="display: flex; justify-content: center; align-items: center; text-align: left;"> -->
      <!--   <img class="mugshot" src="src/assets/me1.jpeg" alt="Mugshot" style="margin-right: 20px;" /> -->
      <!--   <div> -->
      <!--     <h1 style="font-size: 32px; font-weight: bold;"> -->
      <!--       Yasykur Khalis Jati Maulana Yuwono -->
      <!--     </h1> -->
      <!--     <p style="text-align: justify"> -->
      <!--       Information Technology undergraduate student that has an interest in AI and Cloud Computing. Having an experience on optimizing AI models and maintaining servers with some linux experience. -->
      <!--     </p> -->
      <!--   </div> -->
      <!-- </section> -->
      
      <!-- bio -->
      <section class="bio-scroll-animate" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center">
        <img class="hero-animate mugshot opacity-0 translate-y-8 transition-all duration-1000 ease-out" src="src/assets/me5.png" alt="Mugshot" style="margin-bottom: 20px"/>
        <div class="w-full max-w-300">
          <h1 class="hero-animate opacity-0 translate-y-8 transition-all duration-[1500ms] ease-out w-full" style="font-size: 48px; font-weight: bold; margin-bottom: 20px" data-delay="200">
            Yasykur Khalis Jati Maulana Yuwono
          </h1>
          <p class="hero-animate opacity-0 translate-y-8 transition-all duration-[1500ms] ease-out w-full" style="font-size: 32px; text-align: center; margin-bottom: 20px" data-delay="400">
          Information Technology undergraduate student that has an interest in AI and Cloud Computing. Having an experience on optimizing AI models and maintaining servers with some linux experience.
          </p>
        </div>
      </section>
      
      <!-- education -->
      <section class="education-section education-scroll-animate">
        <h1 style="font-size: 48px">Education</h1>
        <ol class="education-timeline">

          <li class="education-item">
            <div class="education-marker" aria-hidden="true"></div>
            <div class="education-content">
              <h2>Institut Teknologi Sepuluh Nopember</h2>
              <p>Information Technology Undergraduate</p>
              <img class="education-logo" src="src/assets/its.png"/>
            </div>
          </li>
          
          <li class="education-item">
            <div class="education-marker" aria-hidden="true"></div>
            <div class="education-content">
              <h2>SMA Negeri 1 Waru</h2>
              <p>Mathematics and Science Track</p>
              <img class="education-logo" src="src/assets/smantaru.png"/>
            </div>
          </li>

        </ol>
      </section>
      
      <!-- Experience -->
      <section>
        <h1>Experience</h1>
      </section>

      <!-- Training -->
      <section>
        <h1>Training</h1>
      </section>

      <!-- Certification -->
      <section>
        <h1>Certification</h1>
      </section>

    </main>
<script src="../scripts/hero-animation.ts"></script>
  </body>
</html>

